# QUESTO FILE E' OPZIONALE.
# "docker compose up" funziona gia' senza crearlo: le credenziali di
# comunicazione tra Tasso (web) e il database (db) sono
# preimpostate di default direttamente in docker-compose.yml
# (utente/password "tasso" su un database "tasso").
#
# Copia questo file in ".env" SOLO se vuoi sovrascrivere quei default
# (fortemente consigliato in produzione: cambia almeno
# DJANGO_SECRET_KEY e POSTGRES_PASSWORD). Il file ".env" reale non va
# mai committato su git (e' gia' in .gitignore).

DJANGO_SECRET_KEY=cambia-questa-chiave-con-una-lunga-e-casuale
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=tasso
POSTGRES_USER=tasso
POSTGRES_PASSWORD=cambia-questa-password

# Opzionale: crea automaticamente un superuser al primo avvio del container.
# Lascia vuote queste tre righe se preferisci crearlo a mano con:
#   docker compose exec web python manage.py createsuperuser
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
